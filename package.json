{
  "name": "dsh-superagent-mail",
  "description": "Mail Source for dsh-superagent: multiple IMAP mailboxes polled for new mail; each mailbox is an independent admission scope; replies go back via SMTP with In-Reply-To threading.",
  "version": "0.1.0",
  "license": "MIT",
  "author": "Shuai-S",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm build",
    "prepare": "pnpm build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1
  },
  "dependencies": {
    "imapflow": "^2.10.0",
    "mailparser": "^3.7.0",
    "nodemailer": "^10.3.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@types/mailparser": "^3.4.0",
    "@types/node": "^22.20.0",
    "@types/nodemailer": "^6.4.0",
    "tsdown": "^0.4.0",
    "typescript": "^5.7.0"
  }
}
